# ------------------------------------------------------------
# Copy this file to  .env  and fill in your Oracle details.
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows)
#
# Leave USE_ORACLE=false (or delete .env) to run the SQLite demo.
# ------------------------------------------------------------

USE_ORACLE=true

ORA_USER=lotus
ORA_PASSWORD=lotus123
ORA_CONNECT=localhost:1521/XEPDB1

# Only needed if thin mode fails (very old Oracle servers):
# ORA_CLIENT_LIB=C:\instantclient_21_12

JWT_SECRET=change-me-to-something-random
PORT=4000
